# Preserve exact native-rendered vectors, standalone iBOM exports and vendored code.
# Export manifests bind exact native-generated bytes; keep their recorded EOLs.
assets/*.json -text whitespace=cr-at-eol
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
assets/schematics/*.svg -text -diff whitespace=-blank-at-eol,cr-at-eol
assets/copper/**/*.svg -text -diff whitespace=-blank-at-eol,cr-at-eol
pcb/*.html -text whitespace=-blank-at-eol,cr-at-eol
vendor/** -text -whitespace
*.glb binary
*.step -text -diff whitespace=cr-at-eol
*.zip binary
*.pdf binary
